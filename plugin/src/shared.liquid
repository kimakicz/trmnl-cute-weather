{%- comment -%}
  cute-weather – klasifikace počasí a výběr vět.
  Vstup:  IDX_0 = Open-Meteo (current, hourly, daily), IDX_1 = texty.json, form field base_url.
  Výstup: cw_ok, cw_obrazek, cw_veta_pocasi, cw_teplota, cw_stupne,
          cw_veta_obleceni, cw_veta_vitr, cw_veta_predpoved (+ cw_kat, cw_obd, cw_doba, cw_doba_textu,
          cw_pasmo, cw_vitr, cw_predpoved pro ladění a testy).
  Pozor: Liquid vyhodnocuje and/or zprava doleva, podmínky proto nemíchají oba operátory.
{%- endcomment -%}

{%- assign cw_base = trmnl.plugin_settings.custom_fields_values.base_url | default: "" | strip -%}
{%- assign cw_posledni = cw_base | slice: -1, 1 -%}
{%- if cw_posledni == "/" -%}
  {%- assign cw_delka = cw_base | size | minus: 1 -%}
  {%- assign cw_base = cw_base | slice: 0, cw_delka -%}
{%- endif -%}

{%- assign cw_cur = IDX_0.current -%}
{%- assign cw_cas = cw_cur.time | append: "" -%}
{%- assign cw_cas_delka = cw_cas | size -%}
{%- assign cw_ok = false -%}
{%- if cw_cas_delka >= 13 and cw_cur.weather_code != nil and cw_cur.temperature_2m != nil -%}
  {%- assign cw_ok = true -%}
{%- endif -%}

{%- assign cw_obrazek = "vychozi_den" -%}
{%- assign cw_veta_pocasi = "Podívej se z okna, jaké je dnes venku počasí." -%}
{%- assign cw_veta_obleceni = "" -%}
{%- assign cw_veta_vitr = "" -%}
{%- assign cw_veta_predpoved = "" -%}
{%- assign cw_predpoved = "" -%}

{%- if cw_ok -%}
  {%- comment -%} čas bereme z Open-Meteo (lokální díky timezone=Europe/Prague), ne z 'now' {%- endcomment -%}
  {%- assign cw_mesic = cw_cas | slice: 5, 2 | plus: 0 -%}
  {%- assign cw_den = cw_cas | slice: 8, 2 | plus: 0 -%}
  {%- assign cw_hodina = cw_cas | slice: 11, 2 | plus: 0 -%}
  {%- assign cw_dny_pred = "0,31,59,90,120,151,181,212,243,273,304,334" | split: "," -%}
  {%- assign cw_mesic_idx = cw_mesic | minus: 1 -%}
  {%- assign cw_den_v_roce = cw_dny_pred[cw_mesic_idx] | plus: cw_den -%}

  {%- comment -%} kategorie podle WMO weather_code {%- endcomment -%}
  {%- assign cw_kod = cw_cur.weather_code | plus: 0 -%}
  {%- assign cw_kat = "zatazeno" -%}
  {%- if cw_kod == 0 -%}{%- assign cw_kat = "jasno" -%}
  {%- elsif cw_kod == 1 or cw_kod == 2 -%}{%- assign cw_kat = "polojasno" -%}
  {%- elsif cw_kod == 45 or cw_kod == 48 -%}{%- assign cw_kat = "mlha" -%}
  {%- elsif cw_kod >= 51 and cw_kod <= 67 -%}{%- assign cw_kat = "dest" -%}
  {%- elsif cw_kod >= 80 and cw_kod <= 82 -%}{%- assign cw_kat = "dest" -%}
  {%- elsif cw_kod >= 71 and cw_kod <= 77 -%}{%- assign cw_kat = "snih" -%}
  {%- elsif cw_kod == 85 or cw_kod == 86 -%}{%- assign cw_kat = "snih" -%}
  {%- elsif cw_kod >= 95 and cw_kod <= 99 -%}{%- assign cw_kat = "bourka" -%}
  {%- endif -%}

  {%- comment -%} období meteorologicky podle měsíce {%- endcomment -%}
  {%- assign cw_obd = "zima" -%}
  {%- if cw_mesic >= 3 and cw_mesic <= 5 -%}{%- assign cw_obd = "jaro" -%}
  {%- elsif cw_mesic >= 6 and cw_mesic <= 8 -%}{%- assign cw_obd = "leto" -%}
  {%- elsif cw_mesic >= 9 and cw_mesic <= 11 -%}{%- assign cw_obd = "podzim" -%}
  {%- endif -%}

  {%- comment -%}
    Obrázek zná jen den/noc podle is_day. Text se řídí hodinou (ráno má být ranní i před
    východem slunce), is_day jen dorovná zimní tmu odpoledne na večer.
  {%- endcomment -%}
  {%- assign cw_doba = "noc" -%}
  {%- if cw_cur.is_day == 1 -%}{%- assign cw_doba = "den" -%}{%- endif -%}
  {%- assign cw_doba_textu = "den" -%}
  {%- if cw_hodina < 5 or cw_hodina >= 21 -%}{%- assign cw_doba_textu = "noc" -%}
  {%- elsif cw_hodina < 9 -%}{%- assign cw_doba_textu = "rano" -%}
  {%- elsif cw_hodina >= 18 or cw_doba == "noc" -%}{%- assign cw_doba_textu = "vecer" -%}
  {%- endif -%}

  {%- comment -%} teplota: pásmo a skloňování {%- endcomment -%}
  {%- assign cw_t = cw_cur.temperature_2m | round -%}
  {%- assign cw_t_abs = cw_t | abs -%}
  {%- assign cw_pasmo = "horko" -%}
  {%- if cw_t < 0 -%}{%- assign cw_pasmo = "mraz" -%}
  {%- elsif cw_t <= 9 -%}{%- assign cw_pasmo = "zima" -%}
  {%- elsif cw_t <= 17 -%}{%- assign cw_pasmo = "chladno" -%}
  {%- elsif cw_t <= 25 -%}{%- assign cw_pasmo = "teplo" -%}
  {%- endif -%}

  {%- assign cw_teplota = cw_t_abs | append: "" -%}
  {%- if cw_t < 0 -%}{%- assign cw_teplota = cw_teplota | prepend: "mínus " -%}{%- endif -%}
  {%- assign cw_stupne = "stupňů" -%}
  {%- if cw_t_abs == 1 -%}{%- assign cw_stupne = "stupeň" -%}
  {%- elsif cw_t_abs >= 2 and cw_t_abs <= 4 -%}{%- assign cw_stupne = "stupně" -%}
  {%- endif -%}

  {%- comment -%} vítr v km/h {%- endcomment -%}
  {%- assign cw_rychlost = cw_cur.wind_speed_10m | default: 0 | plus: 0 -%}
  {%- assign cw_vitr = "slaby" -%}
  {%- if cw_rychlost > 35 -%}{%- assign cw_vitr = "silny" -%}
  {%- elsif cw_rychlost >= 15 -%}{%- assign cw_vitr = "stredni" -%}
  {%- endif -%}

  {%- assign cw_obrazek = cw_kat | append: "_" | append: cw_obd | append: "_" | append: cw_doba -%}

  {%- comment -%}
    Výběr vět: stabilní v rámci hodiny. Počasí = (den v roce × 24 + hodina) mod n;
    oblečení a vítr kombinují den a hodinu jinými násobky, aby se nepárovaly stále stejné indexy.
  {%- endcomment -%}
  {%- assign cw_vety = IDX_1.pocasi[cw_kat][cw_doba_textu] -%}
  {%- assign cw_n = cw_vety | size -%}
  {%- if cw_n > 0 -%}
    {%- assign cw_i = cw_den_v_roce | times: 24 | plus: cw_hodina | modulo: cw_n -%}
    {%- assign cw_veta_pocasi = cw_vety[cw_i] -%}
  {%- endif -%}

  {%- assign cw_vety = IDX_1.obleceni[cw_pasmo] -%}
  {%- assign cw_n = cw_vety | size -%}
  {%- if cw_n > 0 -%}
    {%- assign cw_a = cw_den_v_roce | times: 7 -%}
    {%- assign cw_i = cw_hodina | times: 3 | plus: cw_a | plus: 5 | modulo: cw_n -%}
    {%- assign cw_veta_obleceni = cw_vety[cw_i] -%}
  {%- endif -%}

  {%- if cw_vitr != "slaby" -%}
    {%- assign cw_vety = IDX_1.vitr[cw_vitr] -%}
    {%- assign cw_n = cw_vety | size -%}
    {%- if cw_n > 0 -%}
      {%- assign cw_a = cw_den_v_roce | times: 3 -%}
      {%- assign cw_i = cw_hodina | times: 7 | plus: cw_a | plus: 11 | modulo: cw_n -%}
      {%- assign cw_veta_vitr = cw_vety[cw_i] -%}
    {%- endif -%}
  {%- endif -%}
  {%- comment -%}
    Předpověď (hourly + daily z IDX_0, věty z IDX_1.predpoved). Nejvýš jedna věta:
    5–17 h: srážky později dnes (do 19 h), jinak oteplení o 4 a více stupňů (jen do 13 h);
    18–23 h zítřek (daily[1]), 0–4 h dnešek (daily[0]), který je pro dítě pořád „zítra“.
    Hodinový index se hledá podle času, ne podle hodiny (current.time bývá i 22:15).
  {%- endcomment -%}
  {%- assign cw_pp = IDX_1.predpoved -%}
  {%- assign cw_datum = cw_cas | slice: 0, 10 -%}
  {%- assign cw_pr_druh = "" -%}
  {%- assign cw_pr_kat = "" -%}
  {%- assign cw_pr_h = -1 -%}
  {%- assign cw_pr_t = 0 -%}
  {%- assign cw_dnes_den = IDX_0.daily.time[0] | append: "" -%}
  {%- if cw_hodina >= 5 and cw_hodina < 18 -%}
    {%- if cw_kod < 51 -%}
      {%- assign cw_klic = cw_cas | slice: 0, 13 -%}
      {%- assign cw_start = -1 -%}
      {%- for cw_ht in IDX_0.hourly.time -%}
        {%- assign cw_ht13 = cw_ht | slice: 0, 13 -%}
        {%- if cw_ht13 == cw_klic -%}{%- assign cw_start = forloop.index0 -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if cw_start >= 0 -%}
        {%- assign cw_od = cw_start | plus: 1 -%}
        {%- for cw_ht in IDX_0.hourly.time offset: cw_od -%}
          {%- assign cw_hd = cw_ht | slice: 0, 10 -%}
          {%- assign cw_hh = cw_ht | slice: 11, 2 | plus: 0 -%}
          {%- if cw_hd != cw_datum or cw_hh > 19 -%}{%- break -%}{%- endif -%}
          {%- assign cw_j = forloop.index0 | plus: cw_od -%}
          {%- assign cw_hk = IDX_0.hourly.weather_code[cw_j] | default: 0 | plus: 0 -%}
          {%- if cw_hk >= 51 -%}
            {%- assign cw_pr_druh = "pozdeji" -%}
            {%- assign cw_pr_h = cw_hh -%}
            {%- assign cw_pr_kat = "dest" -%}
            {%- if cw_hk >= 95 -%}{%- assign cw_pr_kat = "bourka" -%}
            {%- elsif cw_hk >= 71 and cw_hk <= 77 -%}{%- assign cw_pr_kat = "snih" -%}
            {%- elsif cw_hk == 85 or cw_hk == 86 -%}{%- assign cw_pr_kat = "snih" -%}
            {%- endif -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
    {%- if cw_pr_druh == "" and cw_hodina < 14 and cw_dnes_den == cw_datum -%}
      {%- assign cw_max = IDX_0.daily.temperature_2m_max[0] -%}
      {%- if cw_max != nil -%}
        {%- assign cw_max = cw_max | round -%}
        {%- assign cw_rozdil = cw_max | minus: cw_t -%}
        {%- if cw_rozdil >= 4 -%}
          {%- assign cw_pr_druh = "otepleni" -%}
          {%- assign cw_pr_t = cw_max -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- elsif cw_dnes_den == cw_datum -%}
    {%- assign cw_di = 0 -%}
    {%- if cw_hodina >= 18 -%}{%- assign cw_di = 1 -%}{%- endif -%}
    {%- assign cw_dk = IDX_0.daily.weather_code[cw_di] -%}
    {%- assign cw_max = IDX_0.daily.temperature_2m_max[cw_di] -%}
    {%- if cw_dk != nil and cw_max != nil -%}
      {%- assign cw_dk = cw_dk | plus: 0 -%}
      {%- assign cw_pr_druh = "zitra" -%}
      {%- assign cw_pr_t = cw_max | round -%}
      {%- assign cw_pr_kat = "zatazeno" -%}
      {%- if cw_dk == 0 -%}{%- assign cw_pr_kat = "jasno" -%}
      {%- elsif cw_dk == 1 or cw_dk == 2 -%}{%- assign cw_pr_kat = "polojasno" -%}
      {%- elsif cw_dk == 45 or cw_dk == 48 -%}{%- assign cw_pr_kat = "mlha" -%}
      {%- elsif cw_dk >= 51 and cw_dk <= 67 -%}{%- assign cw_pr_kat = "dest" -%}
      {%- elsif cw_dk >= 80 and cw_dk <= 82 -%}{%- assign cw_pr_kat = "dest" -%}
      {%- elsif cw_dk >= 71 and cw_dk <= 77 -%}{%- assign cw_pr_kat = "snih" -%}
      {%- elsif cw_dk == 85 or cw_dk == 86 -%}{%- assign cw_pr_kat = "snih" -%}
      {%- elsif cw_dk >= 95 and cw_dk <= 99 -%}{%- assign cw_pr_kat = "bourka" -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign cw_vety = nil -%}
  {%- if cw_pr_druh == "pozdeji" -%}{%- assign cw_vety = cw_pp.pozdeji[cw_pr_kat] -%}
  {%- elsif cw_pr_druh == "otepleni" -%}{%- assign cw_vety = cw_pp.otepleni -%}
  {%- elsif cw_pr_druh == "zitra" -%}{%- assign cw_vety = cw_pp.zitra[cw_pr_kat] -%}
  {%- endif -%}
  {%- assign cw_n = cw_vety | size -%}
  {%- if cw_n > 0 -%}
    {%- assign cw_a = cw_den_v_roce | times: 7 -%}
    {%- assign cw_i = cw_hodina | times: 2 | plus: cw_a | plus: 1 | modulo: cw_n -%}
    {%- assign cw_veta_predpoved = cw_vety[cw_i] -%}
    {%- assign cw_kdy = "večer" -%}
    {%- if cw_pr_h < 12 -%}{%- assign cw_kdy = "dopoledne" -%}
    {%- elsif cw_pr_h < 18 -%}{%- assign cw_kdy = "odpoledne" -%}
    {%- endif -%}
    {%- assign cw_kdy_velke = cw_kdy | capitalize -%}
    {%- assign cw_pt_abs = cw_pr_t | abs -%}
    {%- assign cw_pt = cw_pt_abs | append: "" -%}
    {%- if cw_pr_t < 0 -%}{%- assign cw_pt = cw_pt | prepend: "mínus " -%}{%- endif -%}
    {%- assign cw_pst = "stupňů" -%}
    {%- if cw_pt_abs == 1 -%}{%- assign cw_pst = "stupeň" -%}
    {%- elsif cw_pt_abs >= 2 and cw_pt_abs <= 4 -%}{%- assign cw_pst = "stupně" -%}
    {%- endif -%}
    {%- assign cw_veta_predpoved = cw_veta_predpoved | replace: "{Kdy}", cw_kdy_velke | replace: "{kdy}", cw_kdy | replace: "{teplota}", cw_pt | replace: "{stupne}", cw_pst -%}
    {%- assign cw_predpoved = cw_pr_druh | append: ":" | append: cw_pr_kat | append: ":" -%}
    {%- if cw_pr_druh == "pozdeji" -%}
      {%- assign cw_predpoved = cw_predpoved | append: cw_pr_h -%}
    {%- else -%}
      {%- assign cw_predpoved = cw_predpoved | append: cw_pr_t -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
