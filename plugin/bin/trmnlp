#!/usr/bin/env bash
#
# Spouští trmnlp lokálně (gem trmnl_preview, Ruby >= 3.4) nebo přes Docker.
#
cd "$(dirname "$0")/.." || exit 1

if command -v trmnlp &> /dev/null
then
    trmnlp "$@"
    exit
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/trmnlp"
mkdir -p "$CONFIG_DIR"

if command -v docker &> /dev/null
then
    TTY="-i"; [ -t 0 ] && TTY="-it"   # stdin vždy (kvůli potvrzení u push), TTY jen v terminálu
    docker run $TTY --rm \
        --publish 4567:4567 \
        --volume "$(pwd):/plugin" \
        --volume "$CONFIG_DIR:/root/.config/trmnlp" \
        trmnl/trmnlp "$@"
    exit
fi

echo "Nainstaluj gem (gem install trmnl_preview) nebo Docker: https://docs.docker.com/get-docker/"
exit 1
